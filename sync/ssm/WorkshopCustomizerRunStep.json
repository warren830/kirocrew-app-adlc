{
  "schemaVersion": "2.2",
  "description": "Workshop Customizer: run exactly one allow-listed upstream Workshop Guide step against the active, release-bound tree. The caller cannot supply shell code or paths.",
  "parameters": {
    "ReleaseVersion": {
      "type": "String",
      "description": "Active verified release version",
      "allowedPattern": "^[a-z][a-z0-9-]{2,60}-[0-9a-f]{12}$"
    },
    "StepId": {
      "type": "String",
      "description": "Canonical Workshop Guide step id",
      "allowedValues": ["setup", "infra", "knowledge-base", "gateway", "skills", "agent", "memory", "conversation", "eval-env", "evaluators", "baseline", "optimize", "cost-latency", "models", "judge-stability"]
    },
    "Script": {
      "type": "String",
      "description": "Canonical script paired with StepId; the document verifies the pair before execution",
      "allowedValues": ["00-setup.sh", "00-deploy-infra.sh", "01-create-kb.sh", "02-create-gateway.sh", "03-configure-skills.sh", "04-deploy.sh", "05-setup-memory.sh", "06-test-conversation.sh", "07-setup-eval-env.sh", "08-create-evaluators.sh", "09-run-eval.sh", "10-optimize-prompt.sh", "11-cost-latency.sh", "12-compare-models.sh", "13-judge-stability.sh"]
    }
  },
  "mainSteps": [
    {
      "action": "aws:runShellScript",
      "name": "runAllowlistedWorkshopStep",
      "precondition": {"StringEquals": ["platformType", "Linux"]},
      "inputs": {
        "timeoutSeconds": "7200",
        "workingDirectory": "/opt/workshop-customizer",
        "runCommand": [
          "#!/bin/bash",
          "set -euo pipefail",
          "CONTRACT=/etc/workshop-customizer/target.json",
          "test -f \"$CONTRACT\" || { echo '{\"status\":\"failed\",\"error\":\"target contract missing\"}'; exit 91; }",
          "TARGET_ROOT=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"targetRoot\"])' \"$CONTRACT\")\"",
          "TARGET_USER=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"user\"])' \"$CONTRACT\")\"",
          "TARGET_GROUP=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"group\"])' \"$CONTRACT\")\"",
          "TARGET_REGION=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"region\"])' \"$CONTRACT\")\"",
          "case '{{ StepId }}' in",
          "  setup) EXPECTED_SCRIPT='00-setup.sh' ;;",
          "  infra) EXPECTED_SCRIPT='00-deploy-infra.sh' ;;",
          "  knowledge-base) EXPECTED_SCRIPT='01-create-kb.sh' ;;",
          "  gateway) EXPECTED_SCRIPT='02-create-gateway.sh' ;;",
          "  skills) EXPECTED_SCRIPT='03-configure-skills.sh' ;;",
          "  agent) EXPECTED_SCRIPT='04-deploy.sh' ;;",
          "  memory) EXPECTED_SCRIPT='05-setup-memory.sh' ;;",
          "  conversation) EXPECTED_SCRIPT='06-test-conversation.sh' ;;",
          "  eval-env) EXPECTED_SCRIPT='07-setup-eval-env.sh' ;;",
          "  evaluators) EXPECTED_SCRIPT='08-create-evaluators.sh' ;;",
          "  baseline) EXPECTED_SCRIPT='09-run-eval.sh' ;;",
          "  optimize) EXPECTED_SCRIPT='10-optimize-prompt.sh' ;;",
          "  cost-latency) EXPECTED_SCRIPT='11-cost-latency.sh' ;;",
          "  models) EXPECTED_SCRIPT='12-compare-models.sh' ;;",
          "  judge-stability) EXPECTED_SCRIPT='13-judge-stability.sh' ;;",
          "  *) echo '{\"status\":\"failed\",\"error\":\"step is not allow-listed\"}'; exit 92 ;;",
          "esac",
          "test \"$EXPECTED_SCRIPT\" = '{{ Script }}' || { echo '{\"status\":\"failed\",\"error\":\"step/script pair mismatch\"}'; exit 93; }",
          "RELEASE_DIR=\"$TARGET_ROOT/releases/{{ ReleaseVersion }}\"",
          "CURRENT_DIR=\"$(readlink -f \"$TARGET_ROOT/current\" 2>/dev/null || true)\"",
          "EXPECTED_DIR=\"$(readlink -f \"$RELEASE_DIR\" 2>/dev/null || true)\"",
          "test -n \"$EXPECTED_DIR\" && test \"$CURRENT_DIR\" = \"$EXPECTED_DIR\" || { echo '{\"status\":\"failed\",\"error\":\"requested release is not active\"}'; exit 94; }",
          "test -x \"$RELEASE_DIR/$EXPECTED_SCRIPT\" || { echo '{\"status\":\"failed\",\"error\":\"allow-listed script is missing or not executable\"}'; exit 95; }",
          "LOG_DIR=\"$TARGET_ROOT/run/{{ ReleaseVersion }}/{{ StepId }}\"",
          "install -d -m 0755 -o \"$TARGET_USER\" -g \"$TARGET_GROUP\" \"$LOG_DIR\"",
          "rm -f \"$LOG_DIR/l1-compact.json\" \"$LOG_DIR/result.json\"",
          "case '{{ StepId }}' in",
          "  memory|conversation|eval-env|evaluators|baseline|optimize|cost-latency|models|judge-stability)",
          "    python3 /opt/workshop-customizer/runtime_permissions.py --release-version '{{ ReleaseVersion }}' >\"$LOG_DIR/runtime-permissions.json\" ;;",
          "esac",
          "STDOUT_LOG=\"$LOG_DIR/stdout.log\"",
          "STDERR_LOG=\"$LOG_DIR/stderr.log\"",
          "HOME_DIR=\"$(getent passwd \"$TARGET_USER\" | cut -d: -f6)\"",
          "STEP_ARGS=()",
          "COMPARE_PRICE_IN=''; COMPARE_PRICE_OUT=''",
          "if [ '{{ StepId }}' = models ]; then",
          "  COMPARE_MODEL=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"comparisonModel\"][\"id\"])' \"$CONTRACT\")\"",
          "  COMPARE_PRICE_IN=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"comparisonModel\"][\"inputPricePerMillionUsd\"])' \"$CONTRACT\")\"",
          "  COMPARE_PRICE_OUT=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"comparisonModel\"][\"outputPricePerMillionUsd\"])' \"$CONTRACT\")\"",
          "  STEP_ARGS+=(\"$COMPARE_MODEL\")",
          "fi",
          "if [ '{{ StepId }}' = baseline ]; then",
          "  AGENT_NAME=\"$(python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))[\"namespace\"][\"agentName\"])' \"$RELEASE_DIR/RELEASE.json\")\"",
          "  PROMPT_FILE=\"$TARGET_ROOT/$AGENT_NAME/app/$AGENT_NAME/system-prompt.md\"",
          "  if ! cmp -s \"$RELEASE_DIR/pack/prompts/baseline.md\" \"$PROMPT_FILE\"; then",
          "    install -m 0644 -o \"$TARGET_USER\" -g \"$TARGET_GROUP\" \"$RELEASE_DIR/pack/prompts/baseline.md\" \"$PROMPT_FILE\"",
          "    runuser -u \"$TARGET_USER\" -- env HOME=\"$HOME_DIR\" AWS_DEFAULT_REGION=\"$TARGET_REGION\" PATH=\"/opt/workshop-customizer/bin:$HOME_DIR/.local/bin:/usr/local/bin:/usr/bin:/bin\" bash -c 'cd \"$1\" && npx agentcore deploy --yes' workshop-baseline \"$TARGET_ROOT/$AGENT_NAME\" >\"$LOG_DIR/restore-baseline.log\" 2>&1 || { tail -60 \"$LOG_DIR/restore-baseline.log\" >&2; exit 96; }",
          "  fi",
          "fi",
          "SINCE_MS=''",
          "case '{{ StepId }}' in",
          "  baseline|optimize) SINCE_MS=\"$(($(date +%s) * 1000))\"; printf '%s\\n' \"$SINCE_MS\" >\"$LOG_DIR/since-ms\" ;;",
          "  cost-latency) if [ -f \"$TARGET_ROOT/run/{{ ReleaseVersion }}/optimize/since-ms\" ]; then SINCE_MS=\"$(cat \"$TARGET_ROOT/run/{{ ReleaseVersion }}/optimize/since-ms\")\"; fi ;;",
          "esac",
          "STARTED=$(date +%s)",
          "set +e",
          "runuser -u \"$TARGET_USER\" -- env HOME=\"$HOME_DIR\" AWS_DEFAULT_REGION=\"$TARGET_REGION\" SINCE_EPOCH_MS=\"$SINCE_MS\" WORKSHOP_EVAL_OUT_DIR=\"$LOG_DIR\" COMPARE_PRICE_IN=\"$COMPARE_PRICE_IN\" COMPARE_PRICE_OUT=\"$COMPARE_PRICE_OUT\" WORKSHOP_NONINTERACTIVE=1 PATH=\"/opt/workshop-customizer/bin:$HOME_DIR/.local/bin:/usr/local/bin:/usr/bin:/bin\" bash -c 'cd \"$1\" && script=\"$2\" && shift 2 && exec \"./$script\" \"$@\"' workshop-step \"$RELEASE_DIR\" \"$EXPECTED_SCRIPT\" \"${STEP_ARGS[@]}\" >\"$STDOUT_LOG\" 2>\"$STDERR_LOG\"",
          "RC=$?",
          "set -e",
          "FINISHED=$(date +%s)",
          "python3 - \"$RC\" \"$STDOUT_LOG\" \"$STDERR_LOG\" \"$EXPECTED_SCRIPT\" \"$((FINISHED-STARTED))\" '{{ StepId }}' \"$HOME_DIR/workshop/eval-runs\" <<'PY'",
          "import json, os, pathlib, re, stat, sys, tempfile",
          "rc, out_path, err_path, script, duration, step_id = int(sys.argv[1]), *sys.argv[2:7]",
          "eval_root = sys.argv[7] if len(sys.argv) > 7 else ''",
          "LIMIT = 22000",
          "ITEM, SID = r'[a-z][a-z0-9-]{1,60}', r'[A-Za-z0-9][A-Za-z0-9._:-]{0,127}'",
          "log_dir = pathlib.Path(out_path).parent",
          "out = pathlib.Path(out_path).read_text(encoding='utf-8', errors='replace')",
          "err = pathlib.Path(err_path).read_text(encoding='utf-8', errors='replace')",
          "lines = out.splitlines()",
          "def read_small(path, limit=262144):",
          "    try:",
          "        fd = os.open(str(path), os.O_RDONLY | getattr(os, 'O_NOFOLLOW', 0))",
          "    except OSError:",
          "        return None",
          "    with os.fdopen(fd, 'rb') as fh:",
          "        if not stat.S_ISREG(os.fstat(fh.fileno()).st_mode):",
          "            return None",
          "        data = fh.read(limit + 1)",
          "    return data.decode('utf-8', 'replace') if len(data) <= limit else None",
          "sessions = {}",
          "records = re.findall(r'^📁 Run record: (\\S+)\\s*$', out, re.M)",
          "if records and eval_root:",
          "    root, run_dir = os.path.realpath(eval_root), os.path.realpath(records[-1])",
          "    if run_dir.startswith(root + os.sep):",
          "        for row in (read_small(os.path.join(run_dir, 'sessions.tsv')) or '').splitlines():",
          "            cols = row.split('\\t')",
          "            if len(cols) >= 3 and re.fullmatch(ITEM, cols[1]) and re.fullmatch(SID, cols[2]):",
          "                sessions.setdefault(cols[1], cols[2])",
          "for i in range(len(lines) - 2):",
          "    if re.match(r'^─── Q\\d+ \\[.*\\] ───\\s*$', lines[i]):",
          "        ms = re.search(r'\\(session: (' + SID + r')\\)\\s*$', lines[i + 1])",
          "        mc = re.match(r'^\\s+case: (' + ITEM + r')(\\s|$)', lines[i + 2])",
          "        if ms and mc:",
          "            sessions.setdefault(mc.group(1), ms.group(1))",
          "score_re = re.compile(r'Score:\\s+trace=([^\\s]+)\\s+value=([-+]?[0-9]*\\.?[0-9]+)\\s+\\[([^]]+)\\](?:\\s+case=(' + ITEM + r')(?![a-z0-9-]))?')",
          "metric_re = re.compile(r'(?<![A-Za-z0-9])(GR|SP1|SP2|SQC|RP|RQC|SD)\\([^)]*\\)=([0-9]*\\.?[0-9]+)')",
          "scores, evaluator, pending = [], 'unknown', None",
          "for line in lines:",
          "    if pending is not None:",
          "        found = metric_re.findall(line)",
          "        if found: pending['metrics'] = {k: float(v) for k, v in found}",
          "        pending = None",
          "    if 'THELMA' in line: evaluator = 'thelma_rag_quality'",
          "    elif 'Mind the Goal' in line or '(GSR)' in line: evaluator = 'mtg_goal_success'",
          "    match = score_re.search(line)",
          "    if match:",
          "        row = {'evaluator': evaluator, 'traceId': match.group(1), 'value': float(match.group(2)), 'label': match.group(3)}",
          "        if match.group(4):",
          "            row['caseId'] = match.group(4)",
          "            if match.group(4) in sessions: row['sessionId'] = sessions[match.group(4)]",
          "        scores.append(row)",
          "        if evaluator == 'thelma_rag_quality': pending = row",
          "outputs = {'script': script, 'stepId': step_id, 'exitCode': rc, 'durationSeconds': int(duration), 'stdoutTail': out[-4000:], 'stderrTail': err[-4000:]}",
          "if scores: outputs['scores'] = scores",
          "summary_row = re.search(r'均值/合计\\s+([0-9.]+)\\s+(\\d+)\\s+(\\d+)\\s+([0-9.]+)', out)",
          "average = re.search(r'平均每次回答：延迟\\s+([0-9.]+)s，成本\\s+\\$([0-9.]+)', out)",
          "total = re.search(r'(\\d+)\\s+次合计成本：\\$([0-9.]+)', out)",
          "if summary_row or average or total:",
          "    metrics = {}",
          "    if summary_row: metrics.update({'averageLatencySeconds': float(summary_row.group(1)), 'averageInputTokens': int(summary_row.group(2)), 'averageOutputTokens': int(summary_row.group(3)), 'totalCostUsd': float(summary_row.group(4))})",
          "    if average: metrics.update({'averageLatencySeconds': float(average.group(1)), 'averageCostUsd': float(average.group(2))})",
          "    if total: metrics.update({'sampleCount': int(total.group(1)), 'totalCostUsd': float(total.group(2))})",
          "    outputs['costLatency'] = metrics",
          "    model_match = re.search(r'模型:\\s*(\\S+)', out)",
          "    price_match = re.search(r'单价:\\s*输入\\s*\\$([0-9.]+).*输出\\s*\\$([0-9.]+)', out)",
          "    metrics['estimateOnly'] = True",
          "    if model_match: metrics['modelId'] = model_match.group(1)",
          "    if price_match: metrics.update({'inputPricePerMillionUsd': float(price_match.group(1)), 'outputPricePerMillionUsd': float(price_match.group(2))})",
          "baseline_model = re.search(r'基线模型[^:：]*[:：]\\s*(\\S+)', out)",
          "comparison_model = re.search(r'对比模型[^:：]*[:：]\\s*(\\S+)', out)",
          "if baseline_model or comparison_model: outputs['models'] = {'baseline': baseline_model.group(1) if baseline_model else None, 'comparison': comparison_model.group(1) if comparison_model else None}",
          "values = [float(value) for value in re.findall(r'value\\s*=\\s*([-+]?[0-9]*\\.?[0-9]+)', out)]",
          "stability = re.search(r'均值=([0-9.]+)\\s+标准差=([0-9.]+)\\s+极差=([0-9.]+)', out)",
          "if stability: outputs['judgeStability'] = {'values': values, 'mean': float(stability.group(1)), 'std': float(stability.group(2)), 'spread': float(stability.group(3)), 'verdict': 'stable' if '✅ 稳定：' in out else ('moderate' if '⚠️ 一般：' in out else 'unstable')}",
          "compact_path = log_dir / 'l1-compact.json'",
          "if os.path.lexists(str(compact_path)):",
          "    try:",
          "        compact = json.loads(read_small(compact_path, 65536) or '')",
          "    except ValueError:",
          "        compact = None",
          "    if not isinstance(compact, dict):",
          "        outputs['l1Error'] = 'unreadable l1-compact.json'",
          "    elif compact.get('schema') != 'workshop-customizer/l1/1' or not isinstance(compact.get('cases'), list) or not isinstance(compact.get('summary'), dict):",
          "        outputs['l1Error'] = 'unexpected l1 schema'",
          "    else:",
          "        outputs['l1'] = compact",
          "if step_id == 'conversation':",
          "    sid_match, body, inside = re.search(r'Session ID: (' + SID + r')', out), [], False",
          "    for line in lines:",
          "        if not inside:",
          "            inside = line.startswith('🗣️')",
          "            continue",
          "        if re.match(r'^Session: \\S+', line): break",
          "        body.append(line)",
          "    text = re.sub(r'\\x1b\\[[0-9;]*m', '', '\\n'.join(body)).strip()",
          "    if sid_match or text:",
          "        outputs['conversation'] = {'schema': 'workshop-customizer/conversation/1', 'sessionId': sid_match.group(1) if sid_match else None, 'response': text[:2000], 'responseChars': len(text), 'truncated': len(text) > 2000}",
          "payload = {'status': 'passed' if rc == 0 else 'failed', 'summary': out[-4000:] or (script + ' completed'), 'error': '' if rc == 0 else (err[-4000:] or (script + ' exited ' + str(rc))), 'outputs': outputs}",
          "try:",
          "    fd, tmp = tempfile.mkstemp(prefix='.result-', suffix='.json', dir=str(log_dir))",
          "    os.fchmod(fd, 0o644)",
          "    with os.fdopen(fd, 'w', encoding='utf-8') as fh: fh.write(json.dumps(payload, ensure_ascii=False) + '\\n')",
          "    os.replace(tmp, str(log_dir / 'result.json'))",
          "except OSError:",
          "    outputs['resultFileError'] = 'LOG_DIR/result.json could not be written'",
          "def size(): return len(json.dumps(payload, ensure_ascii=False).encode('utf-8'))",
          "outputs.update(payloadChars=LIMIT, payloadBytes=LIMIT, payloadTrimmed=False)",
          "trimmed = False",
          "for keep in (2000, 800, 200):",
          "    for holder, key in ((payload, 'summary'), (outputs, 'stdoutTail'), (outputs, 'stderrTail'), (payload, 'error')):",
          "        if size() > LIMIT and len(holder.get(key) or '') > keep:",
          "            holder[key], trimmed = holder[key][-keep:], True",
          "if size() > LIMIT and isinstance(outputs.get('l1'), dict) and outputs['l1'].get('cases'):",
          "    outputs['l1'], trimmed = dict(outputs['l1'], cases=[], truncated=True), True",
          "if size() > LIMIT:",
          "    kept = {k: outputs[k] for k in ('script', 'stepId', 'exitCode', 'durationSeconds')}",
          "    payload = {'status': 'failed', 'summary': (script + ' output exceeded the step output budget'), 'error': 'step output exceeded the %d-byte budget; the full result is LOG_DIR/result.json on the workshop instance' % LIMIT, 'outputs': dict(kept, budgetExceeded=True)}",
          "    outputs, trimmed = payload['outputs'], True",
          "for _ in range(4):",
          "    line = json.dumps(payload, ensure_ascii=False)",
          "    if outputs.get('payloadChars') == len(line): break",
          "    outputs.update(payloadChars=len(line), payloadBytes=len(line.encode('utf-8')), payloadTrimmed=trimmed)",
          "line = json.dumps(payload, ensure_ascii=False)",
          "if len(line.encode('utf-8')) > LIMIT:",
          "    payload = {'status': 'failed', 'summary': script + ' output exceeded the step output budget', 'error': 'step output exceeded the %d-byte budget; the full result is LOG_DIR/result.json on the workshop instance' % LIMIT, 'outputs': {k: outputs.get(k) for k in ('script', 'stepId', 'exitCode', 'durationSeconds')}}",
          "    payload['outputs'].update(budgetExceeded=True, payloadTrimmed=True)",
          "    line = json.dumps(payload, ensure_ascii=False)",
          "print(line)",
          "PY",
          "exit \"$RC\""
        ]
      }
    }
  ]
}
